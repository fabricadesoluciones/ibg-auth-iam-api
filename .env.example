# HTTP
PORT=9002
NODE_ENV=development

# Comma-separated origins allowed to call IAM from the browser.
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080,http://[::1]:8080

# Database shared by the IAM service. Use the existing identity database.
DB_NAME=
DB_USER=
DB_PWD=
DB_HOST=127.0.0.1
DB_PORT=3306

# JWT. JWT_SECRETS supports a comma-separated key ring for rotation.
JWT_SECRET=
JWT_SECRETS=
JWT_ACTIVE_KID=0
JWT_EXPIRES_IN=1h
FIRST_ACCESS_TOKEN_EXPIRES_IN=30m

# MFA and password recovery.
MFA_FORCE_FOR_ALL=false
MFA_BYPASS_IN_LOCAL=false
MFA_EXPOSE_CODE_IN_LOCAL=false
MFA_CODE_EXPIRES_IN_MINUTES=10
MFA_EMAIL_ENABLED=false
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=5
PROVIDER_PORTAL_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Microsoft SSO.
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=

